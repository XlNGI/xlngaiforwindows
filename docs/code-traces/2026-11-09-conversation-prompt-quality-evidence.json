  "scenes": [
    {
      "id": "2cd7c3f9-9068-45cf-ba43-326abcb5a835",
      "title": "场一｜秋雨中的抄经院",
      "rowVersion": 0,
      "promptCharacters": 138,
      "promptHash": "b415258589070aabd6a2aa29cf56e1acc2a886fcc59f0df0e2bc343babe89820",
      "promptExcerpt": "昭宁中后期，临渊城连续第五日秋雨。内景，抄经院潮湿灰暗，窗纸受潮发灰，案上是未写完的《安水录》。本场展示沈照从抄经停笔，到管事嬷嬷冒雨交付沾河泥的油布包并下达送往旧档房的禁令；保持古装轻玄幻、克制悬疑，不补写人物未确认的年龄、脸貌、服装颜色和发饰，不新增现代物件或无依据人物。",
      "irPromptMatches": true,
      "durationSeconds": 42,
      "shotCount": 3,
      "shotDurationSeconds": 42,
      "exactChildPromptOccurrences": 0
    },
    {
      "id": "11618d07-7387-4730-8096-5070cfbf416c",
      "title": "场二｜积水巷与旧档房",
      "rowVersion": 0,
      "promptCharacters": 170,
      "promptHash": "256a1677a3dcb9e2ef716a0eb453a2fb97a47966aa999981e241da2c5e71b118",
      "promptExcerpt": "昭宁中后期，临渊城第五日秋雨，从抄经院至城西旧档房。外景积水巷与旧档房门廊连续相接，积水半尺，旧档房门锁着，门上三道褪色封条，门廊下风灯已熄。沈照抱着未拆油布包涉水送件，听见包裹像木桨碰船帮般叩响；她把包裹放在门槛内侧，触门后听见门内回声与死亡名册线索。异常只以声音、纸张和门缝渗水呈现，不新增实体孩子或未确认人物，不补造日期、造型与案情。",
      "irPromptMatches": true,
      "durationSeconds": 55,
      "shotCount": 3,
      "shotDurationSeconds": 52,
      "exactChildPromptOccurrences": 0
    },
    {
      "id": "3badf2b9-979c-4c2d-ba86-6e725773435d",
      "title": "场三｜城南废井",
      "rowVersion": 0,
      "promptCharacters": 169,
      "promptHash": "e61ff92e2df6ca4d33274c6a8ef99256c32fa42b2cd21fbef13c0174140ca1e6",
      "promptExcerpt": "昭宁中后期，临渊城第五日秋雨将近傍晚，城南废井。旧水门河道改后以石板封住，井栏长青苔，井边石板有浅水；雨点落下而水面反常不破。沈照携带已散开的死亡名册与封包材料循叩响而来，依沈槐曾守井的记忆停在井边。她听见井下船歌与呼吸，移开石板，取得半掌长青铜舟钉。玄幻仅表现为反常静水、声音和舟钉微弱青光，不增加法阵或新能力；维持沈照未确认造型开放。",
      "irPromptMatches": true,
      "durationSeconds": 51,
      "shotCount": 3,
      "shotDurationSeconds": 51,
      "exactChildPromptOccurrences": 0
    },
    {
      "id": "f9d88b74-08d8-4ab6-bfdb-2d80624e627a",
      "title": "场四｜舟钉回声与归来",
      "rowVersion": 0,
      "promptCharacters": 236,
      "promptHash": "96c43f37717ba56974b926374a8e14a60cae29ef6fdb3d767c12b7a3b4ef0140",
      "promptExcerpt": "昭宁中后期，临渊城第五日秋雨将近傍晚，城南废井至湿冷石街。承接沈照刚取出青铜舟钉、死亡名册与油布材料在身边的状态。舟钉回声呈现听觉与极短感官影像：白蘋渡、湿透小手按船舷、远处掀舱帘、低声“把名字收好，别让他们看见。”孩子只留下被截断的“顾——”，身份与生死不确认。沈照松手，舟钉落在石板；船歌停、雨声回来。远处更夫梆子和城门方向喊“关水门！河又涨了！”她用油布",
      "irPromptMatches": true,
      "durationSeconds": 44,
      "shotCount": 3,
      "shotDurationSeconds": 46,
      "exactChildPromptOccurrences": 0
    }
  ],
