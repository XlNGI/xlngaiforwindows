      "videoCancellation": true,
      "imageInput": true,
      "videoGeneration": true,
      "videoAsync": true,
      "videoPolling": true,
      "maxImages": 1,
      "supportedImageFormats": ["jpeg", "jpg", "png", "webp"]
    },
    "parameterSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images"],
      "properties": {
        "prompt": {
          "type": "string",
          "title": "视频提示词",
          "minLength": 1,
          "maxLength": 5000,
          "description": "描述生成内容；支持任意语言，官方上限为 2500 个中文字符或 5000 个非中文字符。",
          "pattern": "^(?:[^\\u3400-\\u4DBF\\u4E00-\\u9FFF]*[\\u3400-\\u4DBF\\u4E00-\\u9FFF]){0,2500}[^\\u3400-\\u4DBF\\u4E00-\\u9FFF]*$"
        },
        "images": {
          "type": "array",
          "title": "首帧图片",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^(?:https?://|data:image/(?:jpeg|png|webp);base64,)"
          },
          "description": "JPEG/JPG/PNG/WEBP，单张不超过 20 MB；首帧宽高至少 300 px、宽高比 1:2.5–2.5:1；参考图片短边至少 400 px。支持公开 URL 或图片 Data URL。"
        },
        "resolution": {
          "type": "string",
          "title": "分辨率",
          "enum": ["480P", "720P", "1080P"],
          "default": "1080P",
          "description": "输出画幅比例与首帧图片近似一致，不单独设置 ratio。"
        },
        "duration": {
          "type": "integer",
          "title": "时长（秒）",
          "minimum": 3,
          "maximum": 15,
          "default": 5
        },
        "watermark": {
          "type": "boolean",
          "title": "添加水印",
          "default": true
        },
        "seed": {
          "type": "integer",
          "title": "随机种子",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "transport": {
      "protocolFamily": "dashscope-video",
      "request": [
        {
          "operation": "copy",
          "from": "prompt",
          "to": "input.prompt"
        },
        {
          "operation": "arrayMap",
          "from": "images",
          "to": "input.media",
          "value": {
            "type": "first_frame",
            "url": "$item"
          }
        },
        {
          "operation": "copy",
          "from": "resolution",
          "to": "parameters.resolution"
        },
        {
          "operation": "copy",
          "from": "duration",
          "to": "parameters.duration"
        },
        {
          "operation": "copy",
          "from": "watermark",
          "to": "parameters.watermark"
        },
        {
          "operation": "copy",
          "from": "seed",
          "to": "parameters.seed"
        }
      ],
      "response": [
        {
          "operation": "extract",
          "from": "output.task_id",
          "to": "taskId"
        },
        {
          "operation": "extract",
          "from": "output.task_status",
          "to": "state"
        },
        {
          "operation": "extract",
          "from": "output.video_url",
          "to": "outputUrl"
        }
      ],
      "samples": [
        {
          "request": {
            "model": "happyhorse-1.0-i2v",
            "input": {
              "prompt": "A person walking through a garden",
              "media": [
                {
                  "type": "first_frame",
                  "url": "https://example.com/reference.png"
                }
              ]
            },
            "parameters": {
              "resolution": "720P",
              "watermark": true,
              "seed": 1,
              "duration": 5
            }
          },
          "response": {
            "output": {
              "task_id": "example-task-id",
              "task_status": "SUCCEEDED",
              "video_url": "https://example.com/result.mp4"
            },
            "usage": {
              "output_video_duration": 5
            },
            "request_id": "example-request-id"
          }
        }
      ]
    },
    "lifecycle": {
      "mode": "asynchronous",
      "submit": "/api/v1/services/aigc/video-generation/video-synthesis",
      "status": "/api/v1/tasks/{taskId}",
      "output": "output.video_url",
      "cancel": "/api/v1/tasks/{taskId}/cancel"
    },
    "source": {
