  {
    "contractId": "cn.happyhorse.1.0.i2v",
    "contractRevision": 1,
    "providerFamily": "happyhorse",
    "officialModelName": "happyhorse-1.0-i2v",
    "capabilities": {
      "text": false,
      "vision": false,
