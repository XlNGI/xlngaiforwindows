  {
    "contractId": "cn.happyhorse.1.0.t2v",
    "contractRevision": 1,
    "providerFamily": "happyhorse",
    "officialModelName": "happyhorse-1.0-t2v",
    "capabilities": {
      "text": false,
      "vision": false,
      "audioInput": false,
      "videoInput": false,
      "streaming": false,
      "reasoning": false,
      "tools": false,
      "parallelToolCalls": false,
      "toolChoice": false,
      "structuredOutput": false,
      "jsonMode": false,
      "imageGeneration": false,
      "imageEditing": false,
      "videoCancellation": true,
      "imageInput": false,
      "videoGeneration": true,
      "videoAsync": true,
      "videoPolling": true,
      "maxImages": 0,
      "supportedImageFormats": []
    },
    "parameterSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": {
          "type": "string",
          "title": "视频提示词",
          "minLength": 1,
          "maxLength": 5000,
          "description": "描述生成内容；支持任意语言，官方上限为 2500 个中文字符或 5000 个非中文字符。",
          "pattern": "^(?:[^\\u3400-\\u4DBF\\u4E00-\\u9FFF]*[\\u3400-\\u4DBF\\u4E00-\\u9FFF]){0,2500}[^\\u3400-\\u4DBF\\u4E00-\\u9FFF]*$"
        },
        "resolution": {
          "type": "string",
          "title": "分辨率",
          "enum": ["480P", "720P", "1080P"],
          "default": "1080P"
        },
        "ratio": {
          "type": "string",
          "title": "画幅比例",
          "enum": ["16:9", "9:16", "1:1", "4:3", "3:4", "4:5", "5:4", "9:21", "21:9"],
          "default": "16:9"
        },
        "duration": {
          "type": "integer",
          "title": "时长（秒）",
          "minimum": 3,
          "maximum": 15,
          "default": 5
        },
        "watermark": {
          "type": "boolean",
          "title": "添加水印",
          "default": true
        },
        "seed": {
          "type": "integer",
          "title": "随机种子",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "transport": {
      "protocolFamily": "dashscope-video",
      "request": [
        {
          "operation": "copy",
          "from": "prompt",
          "to": "input.prompt"
        },
        {
          "operation": "copy",
          "from": "resolution",
          "to": "parameters.resolution"
        },
        {
          "operation": "copy",
          "from": "ratio",
          "to": "parameters.ratio"
        },
        {
          "operation": "copy",
          "from": "duration",
          "to": "parameters.duration"
        },
        {
          "operation": "copy",
          "from": "watermark",
          "to": "parameters.watermark"
        },
        {
          "operation": "copy",
          "from": "seed",
          "to": "parameters.seed"
        }
      ],
      "response": [
        {
          "operation": "extract",
          "from": "output.task_id",
          "to": "taskId"
        },
        {
          "operation": "extract",
          "from": "output.task_status",
          "to": "state"
        },
        {
          "operation": "extract",
          "from": "output.video_url",
          "to": "outputUrl"
        }
      ],
      "samples": [
        {
          "request": {
            "model": "happyhorse-1.0-t2v",
            "input": {
              "prompt": "A person walking through a garden"
            },
            "parameters": {
              "resolution": "720P",
              "watermark": true,
              "seed": 1,
              "duration": 5,
              "ratio": "16:9"
            }
          },
          "response": {
            "output": {
              "task_id": "example-task-id",
              "task_status": "SUCCEEDED",
              "video_url": "https://example.com/result.mp4"
            },
            "usage": {
              "output_video_duration": 5
            },
            "request_id": "example-request-id"
          }
        }
      ]
    },
    "lifecycle": {
      "mode": "asynchronous",
      "submit": "/api/v1/services/aigc/video-generation/video-synthesis",
      "status": "/api/v1/tasks/{taskId}",
      "output": "output.video_url",
      "cancel": "/api/v1/tasks/{taskId}/cancel"
    },
    "source": {
      "url": "https://help.aliyun.com/zh/model-studio/happyhorse-text-to-video-api-reference",
